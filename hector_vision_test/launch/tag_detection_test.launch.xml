<launch>
  <arg name="image_dir" default="$(find-pkg-share hector_vision_test)/images"/>
  <arg name="image_frequency" default="0.2"/>
  <arg name="update_frequency" default="5.0"/>
  <node pkg="hector_vision_test" exec="camera_dummy_node">
    <param name="image_dir" value="$(var image_dir)"/>
    <param name="image_frequency" value="$(var image_frequency)"/>
    <param name="update_frequency" value="$(var update_frequency)"/>
  </node>
  <node pkg="hector_tag_detection" exec="tag_detection">
    <remap from="perception/image_percept" to="/detection/visual_detection"/>
  </node>
  <node pkg="rqt_image_view" exec="rqt_image_view"/>
</launch>
